<div class="container mx-auto p-4 md:p-6 flex flex-col md:flex-row gap-6">
    <!-- Left Profile Card -->
    <div class="md:w-1/3">
        <div class="flex justify-between items-center mb-3">
            <h2 class="text-4xl text-gray-700 font-bold">My Profile</h2>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6">

            <div class="flex flex-col items-center mb-6">
                <% if current_user.profile_picture.attached? %>
                <%= image_tag url_for(current_user.profile_picture), alt: "Profile Picture", class: "w-full h-48 object-cover rounded-md mb-4" %>
                <% else %>
                <div class="w-full h-48 bg-gray-300 rounded-md mb-4"></div>
                <% end %>
                <h2 class="text-xl font-semibold"><%= current_user.first_name %> <%= current_user.last_name %></h2>
            </div>

            <div class="space-y-4">
                <div class="flex items-center">
                    <p class="text-gray-700"><%= current_user.phone_number %></p>
                </div>
                <div class="flex items-center">
                    <p class="text-gray-700"><%= current_user.email %></p>
                </div>
                <div class="flex items-center">
                    <p class="text-gray-700"><%= current_user.location %></p>
                </div>
                <div class="text-xs text-gray-400">
                    <span>Last login: <%= Time.now.strftime("%d %b %Y, %H:%M") %></span>
                </div>
            </div>

            <div class="mt-6">
                <%= link_to "Edit", edit_profile_path, class: "bg-gradient-to-r from-orange-500 to-pink-500 text-white font-bold py-2 px-4 rounded-full w-full block text-center" %>
            </div>
        </div>
    </div>

    <!-- Right Cards -->
    <div class="md:w-2/3 space-y-6">
        <!-- Sports Interests Card -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg text-gray-700 font-medium">My sports interests</h2>
            </div>

            <% if current_user.sports.any? %>
            <div class="space-y-3">
                <% current_user.sports.each do |sport| %>
                <div class="flex justify-between items-center">
                    <div class="flex items-center">
                        <span class="w-4 h-4 rounded-full bg-green-500 mr-3"></span>
                        <span class="text-gray-700"><%= sport.name %></span>
                    </div>
                </div>
                <% end %>
            </div>
            <% else %>
            <div class="flex justify-between items-center">
                <p class="text-gray-500 italic">No sports interests selected.</p>
            </div>
            <% end %>
        </div>

        <!-- You can add more cards here if needed -->
    </div>
</div>