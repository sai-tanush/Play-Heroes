<h1 class="text-4xl font-extrabold text-center text-gray-900 mb-8">Your Profile</h1>

<div class="max-w-2xl mx-auto bg-white shadow-xl rounded-2xl p-8 border border-gray-200">
    <!-- Profile Picture Section -->
    <div class="flex flex-col items-center">
        <% if current_user.profile_picture.attached? %>
        <img src="<%= url_for(current_user.profile_picture) %>" alt="Profile Picture" class="w-36 h-36 rounded-full border-4 border-blue-500 shadow-lg">
        <% else %>
        <div class="w-36 h-36 flex items-center justify-center bg-gray-100 rounded-full border-2 border-gray-300 shadow-lg">
            <span class="text-gray-500 text-sm">No Image</span>
        </div>
        <% end %>
        <p class="mt-4 text-lg font-semibold text-gray-800"><%= current_user.first_name %> <%= current_user.last_name %></p>
    </div>

    <!-- User Details -->
    <div class="mt-6 space-y-5">
        <div class="flex items-center gap-3">
            <span class="text-gray-500 text-lg">📧</span>
            <p class="text-lg"><strong class="text-gray-700">Email:</strong> <%= current_user.email %></p>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-gray-500 text-lg">📞</span>
            <p class="text-lg"><strong class="text-gray-700">Phone:</strong> <%= current_user.phone_number %></p>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-gray-500 text-lg">📍</span>
            <p class="text-lg"><strong class="text-gray-700">Location:</strong> <%= current_user.location %></p>
        </div>
    </div>

    <!-- Sports Interests -->
    <div class="mt-6">
        <p class="text-xl font-semibold text-gray-900 border-b pb-2">🏅 Sports Interests</p>
        <% if current_user.sports.any? %>
        <ul class="mt-4 grid grid-cols-2 gap-4">
            <% current_user.sports.each do |sport| %>
            <li class="bg-blue-100 text-blue-700 text-sm px-3 py-1 rounded-full shadow-md text-center font-medium">
                <%= sport.name %>
            </li>
            <% end %>
        </ul>
        <% else %>
        <p class="text-gray-500 mt-4 italic">No sports interests selected.</p>
        <% end %>
    </div>

    <!-- Edit Profile Button -->
    <div class="mt-8 text-center">
        <%= link_to "Edit Profile", edit_profile_path, class: "px-6 py-2 text-lg bg-blue-500 text-white rounded-full shadow-lg hover:bg-blue-600 transition-all" %>
    </div>
</div>