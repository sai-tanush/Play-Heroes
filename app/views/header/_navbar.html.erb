<nav class="bg-gray-100">
    <div class=" lg:w-3/4 mx-auto px-2 sm:px-6 lg:px-8">
        <div class="relative flex h-16 items-center justify-between">
            <div class="w-[100%] flex justify-between">
                <div>
                    <%= link_to root_path, class: "flex shrink-0 items-center" do %>
                    <img class="h-10 w-10" src="<%= asset_path('Icon.png') %>" alt="Play Heroes">
                    <p class="hidden lg:block text-xl lg:text-3xl font-semibold ml-1">PlayHeroes</p>
                    <% end %>
                </div>

                <div class="block mt-2">
                    <ul class="flex space-x-1 lg:space-x-6">
                        <li><%= link_to "Play", play_path, class: "rounded-md px-3 py-2 text-lg hover:text-xl font-semibold text-gray-800 hover:bg-gray-700 hover:text-white transition-all duration-600" %></li>
                        <li><%= link_to "Moments", moments_path, class: "rounded-md px-3 py-2 text-lg hover:text-xl font-semibold text-gray-800 hover:bg-gray-700 hover:text-white transition-all duration-600" %></li>
                        <li><%= link_to "Track", track_path, class: "rounded-md px-3 py-2 text-lg hover:text-xl font-semibold text-gray-800 hover:bg-gray-700 hover:text-white transition-all duration-600" %></li>
                    </ul>
                </div>
                </p>
                <!-- Profile dropdown -->
                <div class="flex items-center">
                    <div class=" relative">
                        <% if user_signed_in? %>
                        <div class="relative group">
                            <button type="button" class="w-20 flex items-center space-x-2 focus:outline-none cursor-pointer">
                                <img class="h-10 w-10 rounded-full border border-gray-300" src="<%= image_path('default_profile_pic.jpg') %>" alt="User Profile">
                            </button>
                            <!-- Dropdown Menu -->
                            <div class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 ring-1 ring-black/5 opacity-0 group-hover:opacity-100 group-hover:block transition-all duration-300">
                                <%= link_to "Profile", profile_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                                <%= link_to "Logout", destroy_user_session_path, data: { "turbo-method": :delete }, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                            </div>
                        </div>
                        <% end %>
                    </div>
                    <div>
                        <% if controller_name == "sessions" && action_name == "new" %>
                        <!-- If on login page, show Sign Up button -->
                        <%= link_to "Sign Up", new_user_registration_path, class: "px-4 py-2 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-lg cursor-pointer" %>

                        <% elsif (controller_name == "registrations" && action_name == "new") || controller_name == "home" %>
                        <!-- If on signup page, show Login button -->
                        <%= link_to "Login", new_user_session_path, class: "px-4 py-2 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-lg cursor-pointer" %>
                        <% end %>

                        <!-- Default (If user is on other pages, show Logout or Profile)
                        <% if user_signed_in? && controller_name != "home" %>
                        <%= link_to "Logout", destroy_user_session_path, data: {"turbo-method": :delete }, class: "px-4 py-2 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-lg cursor-pointer" %>
                        <% end %> -->
                    </div>

                </div>
            </div>
        </div>

</nav>

<!-- <li><%= link_to "Profile", profile_path, class: "rounded-md px-3 py-2 text-lg font-semibold text-gray-800 hover:bg-gray-700 hover:text-white" %></li> -->