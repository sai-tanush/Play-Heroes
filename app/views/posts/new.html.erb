<h1 class="text-2xl font-bold mb-4">Create a New Post</h1>

<%= form_with(model: @post, local: true, html: { multipart: true }, class: "max-w-lg mx-auto bg-white p-6 rounded-lg shadow-md") do |form| %>
<div class="mb-4">
    <%= form.label :description, class: "block text-gray-700 font-semibold mb-2" %>
    <%= form.text_area :description, rows: 4, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring focus:ring-blue-300" %>
</div>

<div class="mb-4">
    <%= form.label :media, "Upload Image/Video", class: "block text-gray-700 font-semibold mb-2" %>
    <%= form.file_field :media, multiple: true, class: "w-full p-2 border border-gray-300 rounded-lg file:bg-blue-500 file:text-white file:rounded-lg file:px-4 file:py-2 hover:file:bg-blue-600 cursor-pointer" %>
</div>

<div class="mt-6">
    <%= form.submit "Create Post", class: "w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg shadow-md transition duration-300" %>
</div>
<% end %>

<div class="mt-4 text-center">
    <%= link_to "Back", moments_path, class: "text-blue-500 hover:underline font-semibold" %>
</div>