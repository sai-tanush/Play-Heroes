<h1>New Post</h1>

<%= form_with(model: @post, local: true, html: { multipart: true }) do |form| %>
<div>
    <%= form.label :description %>
    <%= form.text_area :description, rows: 4, class: "w-full p-2 border rounded" %>
</div>

<div>
    <%= form.label :media, "Upload Image/Video" %>
    <%= form.file_field :media, class: "w-full p-2 border rounded" %>
</div>

<div class="mt-4">
    <%= form.submit "Create Post", class: "bg-blue-500 text-white px-4 py-2 rounded" %>
</div>
<% end %>

<%= link_to "Back", posts_path, class: "text-blue-500 hover:underline" %>