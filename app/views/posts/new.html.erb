<h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Create a New Post</h1>

<div class="max-w-xl mx-auto bg-white p-6 rounded-lg shadow-lg">
    <%= form_with(model: @post, local: true, class: "space-y-4") do |form| %>

    <!-- Description Field -->
    <div>
        <%= form.label :description, class: "block text-gray-700 font-semibold mb-1" %>
        <%= form.text_area :description, rows: 4, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" %>
    </div>

    <!-- Media URL Field -->
    <div>
        <%= form.label :media_url, "Image/Video URL", class: "block text-gray-700 font-semibold mb-1" %>
        <%= form.text_field :media_url, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" %>
    </div>

    <!-- Submit Button -->
    <div class="text-center">
        <%= form.submit "Create Post", class: "bg-blue-500 text-white px-6 py-2 rounded-lg hover:bg-blue-600 transition duration-200" %>
    </div>

    <% end %>
</div>

<!-- Back Link -->
<div class="text-center mt-4">
    <%= link_to "Back", posts_path, class: "text-blue-500 hover:underline" %>
</div>