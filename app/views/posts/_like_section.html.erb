<div id="like_section_<%= post.id %>">
    <div class="flex items-start justify-start gap-2">
        <div class="mt-4 flex gap-x-1 justify-center items-center">
            <div class="mt-1">
                <%= button_to like_post_path(post), form: { data: { turbo: true, turbo_stream: true } }, class: "cursor-pointer #{ current_user.post_likes.find_by(post_id: post.id).present? ? 'text-rose-500' : 'text-gray-500 hover:text-gray-700 active:text-gray-800 ' }" do %>
                <%= icon "volleyball" %>
                <% end %>
            </div>

            <%# like count %>
            <p class="-mt-4 flex justify-center items-center text-gray-600 hover:text-gray-900 transition">
            <div>
                <%= post.post_likes.count %>
            </div>
            <p class="text-gray-600 hover:text-gray-900 transition cursor-pointer"> Likes</p>
            </p>
        </div>

        <!-- View Post Button 
        <div class="mt-4">
            <%= link_to "#", method: :post, class: "text-gray-500 hover:text-blue-500 active:text-blue-600" do %>
            <%= icon "external-link" %>
            <% end %>
        </div> -->

    </div>
</div>