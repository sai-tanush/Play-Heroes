<div id="comment-<%= reply.id %>" class="ml-8 mt-2 flex items-start space-x-2">
    <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center text-gray-600">
        <%= reply.user.first_name ? reply.user.first_name[0].upcase : 'U' %>
    </div>
    <div class="flex bg-gray-200 p-2 rounded-md w-full">
        <div>
            <p class="text-gray-800"><strong><%= reply.user.first_name %></strong>: <%= reply.body %></p>
            <p class="text-gray-500 text-xs"><%= time_ago_in_words(reply.created_at) %> ago</p>
        </div>

        <% if reply.user == current_user %>
        <%= button_to post_comment_path(post, reply),
          method: :delete,
          form: { data: { turbo_confirm: "Are you sure?" } },
          class: "ml-auto text-red-500 hover:text-red-700" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <% end %>
        <% end %>
    </div>
</div>