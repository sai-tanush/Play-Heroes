<h1 class="text-3xl font-bold text-gray-800 mb-6">Edit Post</h1>

<%= form_with(model: @post, local: true, html: { multipart: true }) do |form| %>
<div>
    <%= form.label :description, class: "block text-gray-700 font-semibold" %>
    <%= form.text_area :description, rows: 4, class: "w-full p-2 border rounded" %>
</div>

<div class="mt-4">
    <%= form.label :media, "Upload Image/Video", class: "block text-gray-700 font-semibold" %>
    <%= form.file_field :media, class: "w-full p-2 border rounded" %>
</div>

<div class="mt-4">
    <%= form.submit "Update Post", class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
    <%= link_to "Cancel", moments_path, class: "ml-4 text-gray-500 hover:underline" %>
</div>
<% end %>