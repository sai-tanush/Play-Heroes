<h1>Moments</h1>

<% @posts.each do |post| %>
<div class="border p-4 rounded mb-4">
    <p><strong><%= post.user.first_name %></strong>:</p>
    <p><%= post.description %></p>

    <% if post.media.attached? %>
    <p>Uploaded File:</p>
    <% if post.media.content_type.start_with?('image') %>
    <%= image_tag post.media, class: "w-64 h-64 rounded" %>
    <% elsif post.media.content_type.start_with?('video') %>
    <video controls class="w-64">
        <source src="<%= url_for(post.media) %>" type="<%= post.media.content_type %>">
        Your browser does not support the video tag.
    </video>
    <% end %>
    <% end %>

    <p><%= link_to "View", post_path(post), class: "text-blue-500 hover:underline" %></p>
</div>
<% end %>