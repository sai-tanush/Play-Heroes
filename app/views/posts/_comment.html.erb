<div id="comment-<%= comment.id %>" class="flex items-start space-x-2 mb-2">
    <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center text-gray-600">
        <%= comment.user.first_name ? comment.user.first_name[0].upcase : 'U' %>
    </div>
    <div class="flex flex-col bg-gray-100 p-2 rounded-md w-full">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-gray-800"><strong><%= comment.user.first_name %></strong>: <%= comment.body %></p>
                <p class="text-gray-500 text-xs"><%= time_ago_in_words(comment.created_at) %> ago</p>
            </div>

            <div class="flex justify-end items-start gap-x-2">
                <% if comment.user == current_user %>
                <%= button_to post_comment_path(post, comment),
              method: :delete,
              form: { data: { turbo_confirm: "Are you sure?" } },
              class: "ml-2 text-red-500 hover:text-red-700" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <% end %>
                <% end %>

                <button onclick="showReplyForm('<%= post.id %>', '<%= comment.id %>')" class="ml-2 text-blue-500 text-xs hover:underline cursor-pointer">Reply</button>
            </div>
        </div>

        <div id="reply-form-<%= comment.id %>" class="hidden mt-2">
            <%= render partial: 'posts/reply_form', locals: { post: post, parent_id: comment.id } %>
        </div>

        <div id="comment-replies-<%= comment.id %>" class="space-y-2 mt-2">
            <% comment.replies.each do |reply| %>
            <%= render partial: 'posts/reply', locals: { post: post, reply: reply } %>
            <% end %>
        </div>
    </div>
</div>