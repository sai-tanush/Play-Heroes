<% if @comment.parent_id.nil? %>
  <%= turbo_stream.prepend "comments-list-#{@post.id}" do %>
    <%= render partial: 'posts/comment', locals: { post: @post, comment: @comment } %>
  <% end %>
<% else %>
  <%= turbo_stream.append "comment-replies-#{@comment.parent_id}" do %>
    <%= render partial: 'posts/reply', locals: { post: @post, reply: @comment } %>
  <% end %>
<% end %>

<%= turbo_stream.update "comment-count-#{@post.id}" do %>
  <%= pluralize(@post.comments.count, "comment") %>
<% end %>

<%= turbo_stream.replace "comment-form-#{@post.id}" do %>
  <%= render partial: 'posts/comment_form', locals: { post: @post, comment: Comment.new } %>
<% end %>

<%= turbo_stream.replace "reply-form-#{@comment.parent_id}" do %>
  <div id="reply-form-<%= @comment.parent_id %>" class="hidden mt-2">
    <%= render partial: 'posts/reply_form', locals: { post: @post, parent_id: @comment.parent_id } %>
  </div>
<% end if @comment.parent_id.present? %>