<div class="max-w-lg mx-auto bg-white p-6 rounded-lg shadow-md">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-2">Sports Event Details</h2>

    <div class="mb-4">
        <%= form.label :sport_id, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <div class="relative">
            <%= form.collection_select :sport_id, Sport.all, :id, :name, {}, { class: "appearance-none shadow border rounded w-full py-2 px-3 pl-10 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" } %>
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-700">
                <i class="fas fa-basketball-ball h-4 w-4"></i>
            </div>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700">
                <i class="fas fa-chevron-down h-4 w-4"></i>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <%= form.label :sport_type, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <div class="relative">
            <%= form.select :sport_type, ['Regular', 'Tournament'], {}, { class: "appearance-none shadow border rounded w-full py-2 px-3 pl-10 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" } %>
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-700">
                <i class="fas fa-trophy h-4 w-4"></i>
            </div>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700">
                <i class="fas fa-chevron-down h-4 w-4"></i>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <%= form.label :event_location, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <div class="relative">
            <%= form.text_field :event_location, class: "shadow appearance-none border rounded w-full py-2 px-3 pl-10 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "Enter location" %>
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500">
                <i class="fas fa-map-marker-alt h-4 w-4"></i>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <%= form.label :event_category, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <div class="relative">
            <%= form.select :event_category, ['Beginner', 'Intermediate', 'Professional'], {}, { class: "appearance-none shadow border rounded w-full py-2 px-3 pl-10 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" } %>
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-700">
                <i class="fas fa-tag h-4 w-4"></i>
            </div>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700">
                <i class="fas fa-chevron-down h-4 w-4"></i>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <%= form.label :event_instructions, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <div class="relative">
            <%= form.text_area :event_instructions, class: "shadow appearance-none border rounded w-full py-2 px-3 pl-10 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent", rows: 4, placeholder: "Enter special instructions..." %>
            <div class="pointer-events-none absolute top-2 left-0 flex items-center pl-3 text-gray-500">
                <i class="fas fa-info-circle h-4 w-4"></i>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="mb-4">
            <%= form.label :event_date, class: "block text-gray-700 text-sm font-bold mb-2" %>
            <div class="relative">
                <%= form.date_field :event_date, class: "shadow appearance-none border rounded w-full py-2 px-3 pl-10 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500">
                    <i class="fas fa-calendar h-4 w-4"></i>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <%= form.label :event_capacity, class: "block text-gray-700 text-sm font-bold mb-2" %>
            <div class="relative">
                <%= form.number_field :event_capacity, min: 1, class: "shadow appearance-none border rounded w-full py-2 px-3 pl-10 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "Enter capacity" %>
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500">
                    <i class="fas fa-users h-4 w-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div class="mb-4">
            <%= form.label :event_start_time, class: "block text-gray-700 text-sm font-bold mb-2" %>
            <div class="relative">
                <%= form.time_field :event_start_time, class: "shadow appearance-none border rounded w-full py-2 px-3 pl-10 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500">
                    <i class="fas fa-clock h-4 w-4"></i>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <%= form.label :event_end_time, class: "block text-gray-700 text-sm font-bold mb-2" %>
            <div class="relative">
                <%= form.time_field :event_end_time, class: "shadow appearance-none border rounded w-full py-2 px-3 pl-10 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500">
                    <i class="fas fa-clock h-4 w-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-between">
        <%= form.submit "Create Event", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 transition duration-150 ease-in-out", data: { redirect_url: "/play" } %>
        <%= link_to "<i class=\"fas fa-times mr-1\"></i> Cancel".html_safe, "/play", class: "inline-block text-sm font-medium text-gray-600 hover:text-gray-800" %>
    </div>
</div>