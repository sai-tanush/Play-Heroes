<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6"><%= @play_event.sport.name %></h1>

    <div class="bg-white rounded-lg shadow p-6">
        <p class="text-gray-600 mb-2"><strong>Date:</strong> <%= @play_event.event_date %></p>
        <p class="text-gray-600 mb-2"><strong>Start Time:</strong> <%= @play_event.event_start_time.strftime("%I:%M %p") %></p>
        <p class="text-gray-600 mb-2"><strong>End Time:</strong> <%= @play_event.event_end_time.strftime("%I:%M %p") %></p>
        <p class="text-gray-600 mb-2"><strong>Timeline:</strong> <%= @play_event.event_timeline %></p>
        <p class="text-gray-600 mb-2"><strong>Location:</strong> <%= @play_event.event_location %></p>
        <p class="text-gray-600 mb-2"><strong>Category:</strong> <%= @play_event.event_category %></p>
        <p class="text-gray-600 mb-4"><strong>Instructions:</strong> <%= @play_event.event_instructions %></p>
        <p class="text-gray-600 mb-4"><strong>Maximum Capacity:</strong> <%= @play_event.event_capacity %></p>

        <% if user_signed_in? && current_user != @play_event.host %>
        <%= button_to 'Join Event', join_play_event_path(@play_event), method: :post, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded mt-4" %>
        <% end %>

        <% if user_signed_in? && current_user == @play_event.host %>
        <div class="mt-4">
            <%= link_to 'Edit', edit_play_event_path(@play_event), class: "bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded mr-2" %>
            <%= button_to 'Delete', play_event_path(@play_event), method: :delete, data: { confirm: 'Are you sure?' }, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
        </div>
        <% end %>

        <%= link_to 'Back to Events', play_events_path, class: "inline-block mt-4 text-blue-500 hover:underline" %>

        <% if @play_event.participants.any? %>
        <h3 class="text-xl font-semibold mt-4 mb-2">Participants:</h3>
        <ul>
            <% @play_event.participants.each do |participant| %>
            <li><%= participant.email %></li>
            <% end %>
        </ul>
        <% end %>
    </div>
</div>