<div class="container mx-auto p-6 bg-gray-50">
    <div class="mb-6">
        <%= link_to play_events_path, class: "text-blue-500 hover:text-blue-700 flex items-center" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Events
        <% end %>
    </div>

    <% is_joined = user_signed_in? && @play_event.participants.include?(current_user) %>
    <% is_hosting = user_signed_in? && current_user == @play_event.host %>
    <% has_pending_request = user_signed_in? && JoinRequest.exists?(user: current_user, play_event: @play_event, status: 'pending') %>

    <div class="bg-white rounded-lg shadow-lg overflow-hidden
        <%= is_joined ? 'border-l-4 border-green-500' : 
           (is_hosting ? 'border-l-4 border-purple-500' : 
           (has_pending_request ? 'border-l-4 border-yellow-500' : '')) %>">
        <!-- Event Header -->
        <div class="p-6 border-b">
            <div class="flex flex-col md:flex-row md:justify-between md:items-center">
                <div>
                    <h1 class="text-3xl font-bold text-gray-800"><%= @play_event.sport.name %></h1>
                    <p class="text-gray-600 mt-2">Hosted by <%= @play_event.host.email %></p>
                </div>

                <!-- Status Badges -->
                <div class="mt-4 md:mt-0">
                    <% if is_joined %>
                    <span class="bg-green-100 text-green-800 text-sm font-medium px-3 py-1 rounded-full mb-2 inline-block">You're Participating</span>
                    <% elsif is_hosting %>
                    <span class="bg-purple-100 text-purple-800 text-sm font-medium px-3 py-1 rounded-full mb-2 inline-block">You're Hosting</span>
                    <% elsif has_pending_request %>
                    <span class="bg-yellow-100 text-yellow-800 text-sm font-medium px-3 py-1 rounded-full mb-2 inline-block">Request Pending</span>
                    <% end %>

                    <!-- Join/Request/Leave buttons -->
                    <% if user_signed_in? && current_user != @play_event.host %>
                    <% if @play_event.participants.include?(current_user) %>
                    <%= button_to leave_play_event_path(@play_event), method: :delete, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-6 rounded-lg" do %>
                    Leave Event
                    <% end %>
                    <% elsif has_pending_request %>
                    <% elsif !@play_event.full? %>
                    <button onclick="toggleRequestForm()" class="bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-6 rounded-lg">
                        Request to Join
                    </button>
                    <% else %>
                    <p class="text-red-500 font-medium">This event is full</p>
                    <% end %>
                    <% end %>
                </div>
            </div>
        </div>

        <!-- Request Form (hidden by default) -->
        <div id="request-form" class="hidden p-6 bg-gray-50 border-b">
            <%= form_with url: play_event_join_requests_path(@play_event), method: :post, local: true do |f| %>
            <div class="mb-3">
                <h3 class="font-semibold text-gray-800 mb-2">Request to join this event</h3>
                <%= f.label :message, "Message for host (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_area :message, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500", rows: 3, placeholder: "Example: I'd love to join your event!" %>
            </div>
            <div class="flex space-x-3">
                <%= f.submit "Send Request", class: "bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded-md text-sm" %>
                <button type="button" onclick="toggleRequestForm()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 py-2 px-4 rounded-md text-sm">Cancel</button>
            </div>
            <% end %>
        </div>

        <!-- Event Details -->
        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Left Column - Event Info -->
                <div class="md:col-span-2">
                    <div class="mb-6">
                        <h2 class="text-xl font-semibold mb-3 text-gray-800">Event Details</h2>

                        <div class="space-y-3">
                            <div class="flex items-start">
                                <svg class="w-5 h-5 mr-3 text-blue-500 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                <div>
                                    <p class="font-medium text-gray-800">Date</p>
                                    <p class="text-gray-600"><%= @play_event.event_start_time.strftime("%A, %B %d, %Y") %></p>
                                </div>
                            </div>

                            <div class="flex items-start">
                                <svg class="w-5 h-5 mr-3 text-blue-500 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <div>
                                    <p class="font-medium text-gray-800">Time</p>
                                    <p class="text-gray-600"><%= @play_event.event_start_time.strftime("%I:%M %p") %> - <%= @play_event.event_end_time.strftime("%I:%M %p") %></p>
                                </div>
                            </div>

                            <div class="flex items-start">
                                <svg class="w-5 h-5 mr-3 text-blue-500 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <div>
                                    <p class="font-medium text-gray-800">Location</p>
                                    <p class="text-gray-600"><%= @play_event.event_location %></p>
                                </div>
                            </div>

                            <% if @play_event.event_capacity.present? %>
                            <div class="flex items-start">
                                <svg class="w-5 h-5 mr-3 text-blue-500 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                </svg>
                                <div>
                                    <p class="font-medium text-gray-800">Capacity</p>
                                    <p class="text-gray-600"><%= @play_event.participants.count %>/<%= @play_event.event_capacity %> spots filled</p>
                                </div>
                            </div>
                            <% end %>

                            <% if @play_event.event_instructions.present? %>
                            <div class="flex items-start">
                                <svg class="w-5 h-5 mr-3 text-blue-500 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <div>
                                    <p class="font-medium text-gray-800">Instructions</p>
                                    <p class="text-gray-600"><%= @play_event.event_instructions %></p>
                                </div>
                            </div>
                            <% end %>
                        </div>
                    </div>

                    <!-- Host Controls -->
                    <% if user_signed_in? && current_user == @play_event.host %>
                    <div class="mt-8 bg-gray-50 rounded-lg p-4 border border-gray-200">
                        <h3 class="text-lg font-medium text-gray-800 mb-2">Host Controls</h3>
                        <div class="flex space-x-4">
                            <%= link_to 'Edit Event', edit_play_event_path(@play_event), class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
                            <%= button_to 'Delete Event', play_event_path(@play_event), method: :delete, data: { confirm: 'Are you sure you want to delete this event?' }, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
                        </div>
                    </div>
                    <% end %>
                </div>

                <!-- Right Column - Participants and Join Requests -->
                <div>
                    <!-- Participants Section -->
                    <div class="bg-gray-50 rounded-lg p-4 border border-gray-200 mb-4">
                        <h2 class="text-xl font-semibold mb-3 text-gray-800">Participants</h2>

                        <% if @participants.any? %>
                        <div class="divide-y divide-gray-200">
                            <% @participants.each do |participant| %>
                            <div class="py-3 flex items-center">
                                <div class="h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-500 mr-2">
                                    <%= participant.email.first.upcase %>
                                </div>
                                <span class="text-gray-800 text-sm"><%= participant.email %></span>
                                <% if participant == @play_event.host %>
                                <span class="ml-2 text-xs bg-purple-100 text-purple-800 px-2 py-0.5 rounded">Host</span>
                                <% end %>
                            </div>
                            <% end %>
                        </div>
                        <% else %>
                        <p class="text-gray-500 italic">No participants have joined yet.</p>
                        <% end %>
                    </div>

                    <!-- Join Requests Section (Only visible to host) -->
                    <% if is_hosting && @pending_requests && @pending_requests.any? %>
                    <div class="bg-yellow-50 rounded-lg p-4 border border-yellow-200">
                        <h2 class="text-xl font-semibold mb-3 text-gray-800">Join Requests</h2>

                        <div class="space-y-3">
                            <% @pending_requests.each do |request| %>
                            <div class="bg-white rounded-md shadow-sm p-3">
                                <div class="flex items-center mb-2">
                                    <div class="h-8 w-8 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-600 mr-2">
                                        <%= request.user.email.first.upcase %>
                                    </div>
                                    <span class="text-gray-800 font-medium"><%= request.user.email %></span>
                                </div>

                                <% if request.message.present? %>
                                <div class="bg-gray-50 p-2 rounded text-sm italic text-gray-600 mb-3">
                                    "<%= request.message %>"
                                </div>
                                <% end %>

                                <div class="text-xs text-gray-500 mb-2">
                                    Requested <%= time_ago_in_words(request.created_at) %> ago
                                </div>

                                <div class="flex space-x-2">
                                    <%= button_to 'Accept', accept_join_request_path(request), method: :patch, class: "bg-green-500 hover:bg-green-600 text-white text-sm py-1 px-3 rounded" %>
                                    <%= button_to 'Reject', reject_join_request_path(request), method: :patch, class: "bg-red-500 hover:bg-red-600 text-white text-sm py-1 px-3 rounded" %>
                                </div>
                            </div>
                            <% end %>
                        </div>
                    </div>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleRequestForm() {
        const form = document.getElementById('request-form');
        form.classList.toggle('hidden');
    }
</script>