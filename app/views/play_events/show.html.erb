<div class="container mx-auto p-6 bg-gray-50">
    <div class="mb-6">
        <%= link_to play_events_path, class: "text-blue-500 hover:text-blue-700 flex items-center" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Events
        <% end %>
    </div>

    <% is_joined = user_signed_in? && @play_event.participants.include?(current_user) %>
    <% is_hosting = user_signed_in? && current_user == @play_event.host %>
    <% has_pending_request = user_signed_in? && JoinRequest.exists?(user: current_user, play_event: @play_event, status: 'pending') %>

    <div class="flex flex-col lg:flex-row gap-6">
        <!-- Main Event Column -->
        <div class="lg:w-2/3 space-y-6">
            <div class="bg-white rounded-lg shadow-lg overflow-hidden
            <%= is_joined ? 'border-l-4 border-green-500' : 
               (is_hosting ? 'border-l-4 border-purple-500' : 
               (has_pending_request ? 'border-l-4 border-yellow-500' : '')) %>">

                <!-- Event Header -->
                <div class="p-6 border-b">
                    <div class="flex flex-col md:flex-row md:justify-between md:items-center">
                        <div>
                            <h1 class="text-3xl font-bold text-gray-800"><%= @play_event.sport.name %></h1>
                            <p class="text-gray-600 mt-2">Hosted by <%= @play_event.host.email %></p>
                        </div>

                        <div class="mt-4 md:mt-0">
                            <% if is_joined %>
                            <span class="bg-green-100 text-green-800 text-sm font-medium px-3 py-1 rounded-full mb-2 inline-block">You're Participating</span>
                            <% elsif is_hosting %>
                            <span class="bg-purple-100 text-purple-800 text-sm font-medium px-3 py-1 rounded-full mb-2 inline-block">You're Hosting</span>
                            <% elsif has_pending_request %>
                            <span class="bg-yellow-100 text-yellow-800 text-sm font-medium px-3 py-1 rounded-full mb-2 inline-block">Request Pending</span>
                            <% end %>
                        </div>
                    </div>
                </div>

                <div class="p-6 space-y-6">
                    <div>
                        <h2 class="text-xl font-semibold mb-3 text-gray-800">Event Details</h2>
                        <div class="space-y-3">
                            <!-- Date -->
                            <div class="flex items-start">
                                <svg class="w-5 h-5 mr-3 text-blue-500 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                <div>
                                    <p class="font-medium text-gray-800">Date</p>
                                    <p class="text-gray-600"><%= @play_event.event_start_time.strftime("%A, %B %d, %Y") %></p>
                                </div>
                            </div>

                            <!-- Time -->
                            <div class="flex items-start">
                                <svg class="w-5 h-5 mr-3 text-blue-500 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <div>
                                    <p class="font-medium text-gray-800">Time</p>
                                    <p class="text-gray-600"><%= @play_event.event_start_time.strftime("%I:%M %p") %> - <%= @play_event.event_end_time.strftime("%I:%M %p") %></p>
                                </div>
                            </div>

                            <!-- Location -->
                            <div class="flex items-start">
                                <svg class="w-5 h-5 mr-3 text-blue-500 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <div>
                                    <p class="font-medium text-gray-800">Location</p>
                                    <p class="text-gray-600"><%= @play_event.event_location %></p>
                                </div>
                            </div>

                            <!-- Capacity (if present) -->
                            <% if @play_event.event_capacity.present? %>
                            <div class="flex items-start">
                                <svg class="w-5 h-5 mr-3 text-blue-500 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                </svg>
                                <div>
                                    <p class="font-medium text-gray-800">Capacity</p>
                                    <p class="text-gray-600"><%= @play_event.participants.count %>/<%= @play_event.event_capacity %> spots filled</p>
                                </div>
                            </div>
                            <% end %>

                            <!-- Instructions (if present) -->
                            <% if @play_event.event_instructions.present? %>
                            <div class="flex items-start">
                                <svg class="w-5 h-5 mr-3 text-blue-500 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <div>
                                    <p class="font-medium text-gray-800">Instructions</p>
                                    <p class="text-gray-600"><%= @play_event.event_instructions %></p>
                                </div>
                            </div>
                            <% end %>

                            <!-- Participation Buttons -->
                            <div class="mt-4 flex items-center space-x-3">
                                <% if is_joined %>
                                <%= button_to 'Leave Event', leave_play_event_path(@play_event), 
                                    method: :delete, 
                                    data: { 
                                        confirm: 'Are you sure you want to leave this event?' 
                                    }, 
                                    class: "bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded transition duration-300" %>

                                <% elsif is_hosting %>
                                <div class="flex space-x-3">
                                    <%= button_to 'Delete Event', play_event_path(@play_event), 
                                        method: :delete, 
                                        data: { 
                                            confirm: 'Are you sure you want to delete this event? This action cannot be undone.' 
                                        }, 
                                        class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded transition duration-300" %>

                                    <%= link_to 'Edit Event', edit_play_event_path(@play_event), 
                                        class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded transition duration-300" %>
                                </div>

                                <% else %>
                                <%= button_to 'Join Event', join_play_event_path(@play_event), 
                                    method: :post, 
                                    class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded transition duration-300" %>
                                <% end %>
                            </div>
                        </div>
                    </div>

                    <!-- Host Controls -->
                    <% if user_signed_in? && current_user == @play_event.host %>
                    <div class="mt-8 bg-gray-50 rounded-lg p-4 border border-gray-200">
                        <h3 class="text-lg font-medium text-gray-800 mb-2">Host Controls</h3>
                        <div class="flex space-x-4">
                            <%= link_to 'Edit Event', edit_play_event_path(@play_event), class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
                            <%= button_to 'Delete Event', play_event_path(@play_event), method: :delete, data: { confirm: 'Are you sure you want to delete this event?' }, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
                        </div>
                    </div>
                    <% end %>
                </div>

            </div>

            <!-- Chat Section - For both Host and Participants -->
            <div>
                <% if (is_joined || is_hosting) && @play_event.event_start_time > Time.current %>
                <div class="mt-6 bg-white rounded-lg shadow-lg overflow-hidden">
                    <div class="bg-blue-50 p-4 border-b flex justify-between items-center">
                        <h2 class="text-xl font-semibold text-gray-800">Event Chat</h2>
                        <span class="text-sm text-gray-500">
                            Active until event starts
                        </span>
                    </div>

                    <!-- Chat Messages Container -->
                    <div id="chat-container" class="h-[500px] overflow-y-auto p-4 space-y-4 bg-gray-50">
                        <% if @event_chats&.any? %>
                        <% @event_chats.each do |chat| %>
                        <div class="flex items-start space-x-3 
                        <%= chat.user == current_user ? 'flex-row-reverse' : '' %>">
                            <div class="ml-2 h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-500">
                                <%= chat.user.email.first.upcase %>
                            </div>
                            <div class="max-w-[70%] 
                          <%= chat.user == current_user ? 'bg-blue-500 text-white' : 'bg-gray-100 text-gray-800' %> 
                          rounded-lg p-3 shadow-sm relative">
                                <p class="text-sm"><%= chat.message %></p>
                                <span class="text-xs opacity-70 block mt-1">
                                    <%= chat.user == current_user ? 'You' : chat.user.email.split('@').first %>
                                    • <%= time_ago_in_words(chat.created_at) %> ago
                                </span>
                                <div class="absolute bottom-[-8px] 
                                <%= chat.user == current_user ? 'right-2 bg-blue-500' : 'left-2 bg-gray-100' %> 
                                w-4 h-4 transform rotate-45"></div>
                            </div>
                        </div>
                        <% end %>
                        <% else %>
                        <div class="text-center text-gray-500 italic py-10">
                            No messages yet. Start the conversation!
                        </div>
                        <% end %>
                    </div>

                    <!-- Chat Input -->
                    <%= form_with(
                  model: [@play_event, EventChat.new], 
                  url: create_chat_play_event_path(@play_event), 
                  method: :post, 
                  local: true, 
                  class: "p-4 bg-white border-t flex items-center space-x-3"
                ) do |f| %>
                    <%= f.text_area :message, 
                    placeholder: "Type your message...", 
                    class: "flex-grow p-3 border rounded-lg focus:ring-2 focus:ring-blue-300 resize-none",
                    rows: 1 
                  %>
                    <%= f.submit "Send", 
                    class: "bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-lg transition duration-300 ease-in-out transform hover:-translate-y-1" 
                  %>
                    <% end %>
                </div>
                <% end %>

            </div>


        </div>
        <!-- Right Sidebar Column -->
        <div class="lg:min-w-[25rem]">
            <!-- Participants Section -->
            <div class="bg-white rounded-lg shadow-lg p-6">
                <h2 class="text-xl font-semibold mb-4 text-gray-800">Participants</h2>

                <% if @participants.any? %>
                <div class="divide-y divide-gray-200">
                    <% @participants.each do |participant| %>
                    <div class="py-3 flex items-center">
                        <div class="h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-500 mr-3">
                            <%= participant.first_name[0].upcase %><%= participant.last_name[0].upcase %>
                        </div>
                        <div class="flex-grow">
                            <span class="text-gray-800 text-sm block"><%= "#{participant.first_name} #{participant.last_name}" %></span>
                        </div>
                        <% if participant == @play_event.host %>
                        <span class="text-xs bg-purple-100 text-purple-800 px-2 py-0.5 rounded">Host</span>
                        <% end %>
                    </div>
                    <% end %>
                </div>
                <% else %>
                <p class="text-gray-500 italic">No participants have joined yet.</p>
                <% end %>
            </div>

            <!-- Join Requests Section (for host) -->
            <% if is_hosting && @pending_requests&.any? %>
            <div class="bg-white rounded-lg shadow-lg p-6">
                <h2 class="text-xl font-semibold mb-4 text-gray-800">Join Requests</h2>
                <div class="space-y-3">
                    <% @pending_requests.each do |request| %>
                    <div class="flex items-center justify-between bg-yellow-50 p-3 rounded-lg">
                        <div class="flex items-center">
                            <div class="h-8 w-8 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-500 mr-3">
                                <%= request.user.email.first.upcase %>
                            </div>
                            <span class="text-gray-800 text-sm"><%= request.user.email %></span>
                        </div>
                        <div class="flex space-x-2">
                            <%= button_to 'Accept', accept_join_request_path(request), method: :patch, class: "bg-green-500 text-white text-xs px-2 py-1 rounded" %>
                            <%= button_to 'Reject', reject_join_request_path(request), method: :patch, class: "bg-red-500 text-white text-xs px-2 py-1 rounded" %>
                        </div>
                    </div>
                    <% end %>
                </div>
            </div>
            <% end %>
        </div>
    </div>



    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const chatContainer = document.getElementById('chat-container');
            if (chatContainer) {
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }
        });

        function scrollToBottom() {
            const chatContainer = document.getElementById('chat-container');
            if (chatContainer) {
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }
        }
    </script>