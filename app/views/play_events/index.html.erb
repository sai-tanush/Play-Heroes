<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6">Upcoming Events</h1>

    <div class="mb-4">
        <%= link_to 'Create New Event', new_play_event_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @play_events.each do |event| %>
        <div class="bg-white rounded-lg shadow p-4">
            <h2 class="text-xl font-semibold mb-2"><%= event.sport.name %></h2>
            <p class="text-gray-600 mb-1">Date: <%= event.event_date %></p>
            <p class="text-gray-600 mb-1">Time: <%= event.event_start_time.strftime("%I:%M %p") %> - <%= event.event_end_time.strftime("%I:%M %p") %></p>
            <p class="text-gray-600 mb-1">Location: <%= event.event_location %></p>
            <%= link_to 'View Details', play_event_path(event), class: "text-blue-500 hover:underline" %>
            <% if user_signed_in? && current_user == event.host %>
            <div class="mt-2">
                <%= link_to 'Edit', edit_play_event_path(event), class: "text-green-500 hover:underline mr-2" %>
                <%= button_to 'Delete', play_event_path(event), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-500 hover:underline" %>
            </div>
            <% end %>
        </div>
        <% end %>
    </div>
</div>