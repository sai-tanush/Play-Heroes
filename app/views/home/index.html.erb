<div class="h-screen w-screen bg-cover bg-center bg-no-repeat" style="background-image: url('<%= asset_url("LandingPage.png") %>');">

    <!-- Content on Top -->
    <div class="z-10 flex flex-col items-center justify-center h-full text-white text-center px-6">
        <div class="flex flex-col items-center justify-center -mt-10">
            <h1 class="text-2xl lg:text-6xl font-bold self-start">Play. Connect. Track.</h1>
            <h2 class="text-xl lg:text-4xl mt-2 font-bold self-start">Elevate your game with PlayHeroes!</h2>
            <p class="text-lg mt-2  max-w-2xl font-semibold text-left">
                Find players, join tournaments, share your moments and track your fitness! </br> - all in one place
            </p>
            <%= link_to "/users/sign_up", class:"mt-6 px-6 py-3 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-lg cursor-pointer self-start" do %>
